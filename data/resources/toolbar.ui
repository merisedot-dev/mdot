<interface>
  <!-- interface-name toolbar.ui -->
  <requires lib="gtk" version="4.6"/>
  <template class="MDotToolbar" parent="GtkBox">
    <property name="orientation">vertical</property>
    <style>
      <class name="toolbar"/>
    </style>
  </template>
</interface>
