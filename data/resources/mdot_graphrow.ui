<interface>
  <!-- interface-name mdot_graphrow.ui -->
  <requires lib="gtk" version="4.0"/>
  <template class="MDotGraphRow" parent="GtkListBoxRow">
    <property name="child">
      <object class="GtkBox">
        <child>
          <object class="GtkImage"/>
        </child>
        <child>
          <object class="GtkLabel"/>
        </child>
      </object>
    </property>
  </template>
</interface>
