<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0 -->
<interface>
  <!-- interface-name mdot_graphrow.ui -->
  <requires lib="gtk" version="4.0"/>
  <template class="MDotGraphRow" parent="GtkListBoxRow">
    <property name="child">
      <object class="GtkBox">
        <child>
          <object class="GtkImage" id="item_icon">
            <property name="icon-name"/>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="item_lbl"/>
        </child>
      </object>
    </property>
  </template>
</interface>
